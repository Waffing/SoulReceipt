# 数据库连接串（PostgreSQL：推荐 Supabase / Neon 免费托管，本地也可用 Docker Postgres）
# Supabase 获取路径：项目 Dashboard → Connect → Connection string → URI，
# 把 [YOUR-PASSWORD] 替换为你创建项目时设置的数据库密码
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# 可选：兼容 OpenAI 格式的大模型配置（如 DeepSeek / 通义千问 / OpenAI）
# 若留空，系统将自动启用内置的「高拟真本地模因算账引擎」，100% 功能可用！
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# 站点公开访问域名（用于生成小票底部的分享二维码）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
