# 数据库连接串（本地开发默认使用 SQLite，生产环境可替换为 PostgreSQL / Supabase 连接串）
DATABASE_URL="file:./dev.db"

# 可选：兼容 OpenAI 格式的大模型配置（如 DeepSeek / 通义千问 / OpenAI）
# 若留空，系统将自动启用内置的「高拟真本地模因算账引擎」，100% 功能可用！
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# 站点公开访问域名（用于生成小票底部的分享二维码）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
