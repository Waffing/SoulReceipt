# 运行时连接串（Vercel 函数用）：Supabase 事务池化端点（Transaction pooler，6543 端口）
# 获取路径：项目 Dashboard → Connect → Connection string → Transaction pooler 标签
# 必须带 ?pgbouncer=true&connection_limit=1 参数，适配 Serverless 短连接
DATABASE_URL="postgresql://postgres.[项目ID]:[YOUR-PASSWORD]@aws-0-[区域].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 建表/迁移用直连通道（Session pooler，5433/5432 端口，支持 DDL）
# 获取路径：同上弹窗 → Session pooler 标签
DIRECT_URL="postgresql://postgres.[项目ID]:[YOUR-PASSWORD]@aws-0-[区域].pooler.supabase.com:5432/postgres"

# 可选：兼容 OpenAI 格式的大模型配置（如 DeepSeek / 通义千问 / OpenAI）
# 若留空，系统将自动启用内置的「高拟真本地模因算账引擎」，100% 功能可用！
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# 站点公开访问域名（用于生成小票底部的分享二维码）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
